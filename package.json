{
  "name": "bun-logger",
  "version": "1.1.0",
  "license": "MIT",
  "keywords": [
    "bun",
    "logging",
    "logger"
  ],
  "author": "Kjur <krzysztof@jurkowski.net.pl>",
  "homepage": "https://github.com/Kjur0/bun-logger",
  "bugs": {
    "url": "https://github.com/Kjur0/bun-logger/issues"
  },
  "repository": "github:Kjur0/bun-logger",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "demo": "bun demo.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.2",
    "@types/bun": "latest",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.1",
    "typedoc": "^0.28.19",
    "typedoc-github-theme": "^0.4.0",
    "typescript-eslint": "^8.62.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "onFail": "error"
    }
  }
}
